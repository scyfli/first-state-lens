{
  // Cloudflare Worker configuration for `first-state-lens`.
  //
  // Static assets are served from the repo root exactly as they are (no build step).
  // Since 2026-10-05 a small Worker script (worker/index.js) also handles /api/* only:
  // the "Your 2026 ballot" district lookup (docs/UPGRADE-PLAN.md, E2). Every other
  // request goes straight to the assets (run_worker_first is limited to /api/*).
  //
  // Pinning this file also stops Workers Builds from running framework autoconfig
  // (it once mis-detected the Python ETL as a Python project and failed the deploy).
  //
  // Privacy: observability is OFF so no request data reaches Workers Logs; the script
  // has no console output. .assetsignore keeps worker/ out of the public assets.
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "first-state-lens",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-11",
  "observability": { "enabled": false },
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
