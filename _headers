# Cloudflare Pages headers configuration
# Applied at the edge; in addition to inline <meta> tags in HTML.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  # Always revalidate so a new deploy shows immediately — no stale cached HTML/CSS/JS.
  Cache-Control: no-cache

# Held page: Clean Slate predates the neutrality-firewall pivot and has no real
# dataset yet, so it is kept out of search until rebuilt to the public standard.
# It also carries an inline <meta robots noindex> and a client-side password gate.
# (DGI Food Access was rebuilt to the neutrality standard and un-held 2026-07-05.)
/clean-slate/*
  X-Robots-Tag: noindex, nofollow

# Candidate Record flipped public 2026-07-23: filing slate final (deadline noon
# July 14, 2026) and routes already in sitemap.xml + allowed in robots.txt. The
# stale noindex block was removed so the pages can be indexed (they had been
# invited via sitemap yet blocked at the edge — a self-defeating contradiction).

# Static brand assets (favicon, OG image, icons) can be cached hard — they are
# content-stable and versioned by filename. Speeds repeat loads / Core Web Vitals.
/assets/og-image.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
