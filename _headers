# Cloudflare Pages headers configuration
# Applied at the edge; in addition to inline <meta> tags in HTML.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  # Always revalidate so a new deploy shows immediately — no stale cached HTML/CSS/JS.
  Cache-Control: no-cache

# Held pages: DGI Food Access and Clean Slate predate the neutrality-firewall
# pivot and are kept out of search until rebuilt to the public standard. They
# also carry an inline <meta robots noindex> and a client-side password gate.
/dgi-food-access/*
  X-Robots-Tag: noindex, nofollow

/clean-slate/*
  X-Robots-Tag: noindex, nofollow
