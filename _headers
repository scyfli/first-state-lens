# Cloudflare Pages headers configuration
# Applied at the edge; in addition to inline <meta> tags in HTML.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  # Always revalidate so a new deploy shows immediately — no stale cached HTML/CSS/JS.
  Cache-Control: no-cache

# Held page: Clean Slate predates the neutrality-firewall pivot and has no real
# dataset yet, so it is kept out of search until rebuilt to the public standard.
# It also carries an inline <meta robots noindex> and a client-side password gate.
# (DGI Food Access was rebuilt to the neutrality standard and un-held 2026-07-05.)
/clean-slate/*
  X-Robots-Tag: noindex, nofollow

# Held during build: the Candidate Record (2026 election) is kept out of search
# until every candidate fact is verified against its primary source AND the official
# candidate slate is final (major-party filing deadline noon July 14, 2026). Flip
# public by removing this block + the robots.txt Disallow + adding the routes to
# sitemap.xml, all together, once verified.
/candidates/*
  X-Robots-Tag: noindex, nofollow
